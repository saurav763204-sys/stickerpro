{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stickerpro",
  "main": "worker.js",
  "compatibility_date": "2026-08-17",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stickerpro-db",
      "database_id": "88f80cd6-e18c-4d28-b6b2-425cfccc2506"
    }
  ]
}
